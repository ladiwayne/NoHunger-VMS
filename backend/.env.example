PORT=5000
MONGODB_URI=mongodb://localhost:27017/nohunger-vms
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
NODE_ENV=development
# Comma-separated list of allowed frontend origins (required in production)
ALLOWED_ORIGINS=http://localhost:4028,https://your-frontend.vercel.app
# Frontend URL used for generating event check-in links and password reset links
FRONTEND_URL=http://localhost:4028
SUPER_ADMIN_SETUP_KEY=change-this-to-a-secret-key