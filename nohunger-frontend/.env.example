# Public backend API base used by browser-side requests.
# Must be an absolute URL and should end with /api.
NEXT_PUBLIC_API_URL=https://your-backend-domain.com/api

# Server-side backend API base used by Next.js route handlers.
# Keep this identical to NEXT_PUBLIC_API_URL for consistency.
BACKEND_URL=https://your-backend-domain.com/api

# Public frontend URL
NEXT_PUBLIC_SITE_URL=https://your-frontend-domain.com

# Optional Supabase settings if using Supabase services
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
